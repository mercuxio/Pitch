<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Pitch</string>
    <key>CFBundleDisplayName</key>
    <string>Pitch</string>
    <key>CFBundleExecutable</key>
    <string>Pitch</string>
    <!-- An LSUIElement app has no dock tile, but Finder, Login Items and the
         installer all still ask for this. -->
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <key>CFBundleIdentifier</key>
    <string>com.houlanyit.Pitch</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.2.1</string>
    <key>CFBundleVersion</key>
    <string>4</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- Menu bar agent: no dock icon, no app switcher entry. -->
    <key>LSUIElement</key>
    <true/>
    <!-- Sparkle. The feed is the appcast.xml on main; every update is checked
         against the EdDSA public key below, whose private half lives in the
         login Keychain and never in the repository (spec §15). -->
    <key>SUFeedURL</key>
    <string>https://raw.githubusercontent.com/mercuxio/Pitch/main/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>10VIpTMQm9DmV5p6kNgsHBI3Fwd06CSUKhUM8HMhbis=</string>
    <!-- Start with automatic checks on, so Sparkle does not interrupt a menu
         bar app with its own first-run permission prompt. The gear's tick
         turns them off. -->
    <key>SUEnableAutomaticChecks</key>
    <true/>
</dict>
</plist>
